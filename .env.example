# =====================================================================
# SOLARAC Company LTD - Production Environment Configuration
# =====================================================================

# Application Environment (production / development)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://solaraccompany.com
APP_KEY=solarac_sec_key_2026_prod_32bytes_random

# Database Configuration (MySQL / MariaDB via PDO)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=solajmrx_solarac_db
DB_USER=solajmrx_solarac_user
DB_PASS=YourDatabaseUserPasswordHere

# SMTP Mail Server Configuration
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=info@solaraccompany.com
MAIL_PASSWORD=YourEmailPasswordHere
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@solaraccompany.com
MAIL_FROM_NAME="SOLARAC Company LTD"

# Security & Session Settings
SESSION_LIFETIME=7200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
